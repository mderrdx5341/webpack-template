{
  "name": "webpack_template",
  "description": "webpack_template",
  "version": "0.0.1",
  "main": "index.js",
  "scripts": {
    "test": "nyc mocha --require ts-node/register --require ./test-setup.ts \"frontend/src/**/*Test.ts\"",
    "_posttest": "node -e \"const open = require('child_process').exec; open('start coverage/index.html');\"",
    "test:watch": "nodemon --watch frontend/src --ext ts --exec \"mocha --require ts-node/register --require ./test-setup.ts \\\"frontend/src/**/*Test.ts\\\"\"",
    "build": "cross-env NODE_ENV=production webpack",
    "watch": "cross-env NODE_ENV=development webpack --watch"
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "report-dir": "./coverage",
    "extension": [
      ".ts",
      ".tsx"
    ],
    "include": [
      "frontend/src/**/*.ts"
    ],
    "exclude": [
      "frontend/src/app.ts",
      "**/*Test.ts",
      "**/*.d.ts",
      "**/tests/*"
    ],
    "reporter": [
      "html",
      "text",
      "text-summary"
    ],
    "all": true
  },
  "author": "mderrdx",
  "license": "ISC",
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "@types/sinon": "^22.0.2",
    "babel-loader": "^10.1.1",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "jsdom": "^30.1.3",
    "mini-css-extract-plugin": "^2.10.2",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "postcss-loader": "^8.2.1",
    "sass": "^1.107.1",
    "sass-loader": "^17.1.0",
    "sinon": "^22.1.0",
    "ts-loader": "^9.6.2",
    "ts-node": "10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
